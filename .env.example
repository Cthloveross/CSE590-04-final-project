# MongoDB Connection
MONGODB_URI=mongodb+srv://your-user:your-password@your-cluster.mongodb.net/game-services?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# OAuth - Google
NUXT_OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth - GitHub
NUXT_OAUTH_GITHUB_CLIENT_ID=your-github-client-id
NUXT_OAUTH_GITHUB_CLIENT_SECRET=your-github-client-secret

# Site URL (for OAuth callbacks)
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_SESSION_PASSWORD=your-session-password-at-least-32-chars-long-here

# OAuth Redirect URLs (must match Google/GitHub OAuth settings)
NUXT_OAUTH_GOOGLE_REDIRECT_URL=http://localhost:3000/api/auth/callback/google
NUXT_OAUTH_GITHUB_REDIRECT_URL=http://localhost:3000/api/auth/callback/github
