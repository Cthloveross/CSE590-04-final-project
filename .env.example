# =============================================================================
# GameBoost Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# MongoDB Atlas Connection (REQUIRED)
# -----------------------------------------------------------------------------
# Get this from MongoDB Atlas:
# 1. Go to https://cloud.mongodb.com/
# 2. Select your cluster → Click "Connect" → "Connect your application"
# 3. Copy the connection string and replace <password> with your DB user password
#
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
MONGODB_URI=mongodb+srv://your-user:your-password@your-cluster.mongodb.net/game-services?retryWrites=true&w=majority

# Nuxt also needs this (same value as above)
NUXT_MONGODB_URI=mongodb+srv://your-user:your-password@your-cluster.mongodb.net/game-services?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# JWT Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Generate a secure random string (at least 32 characters)
# You can use: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production
NUXT_JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Session Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Must be at least 32 characters for secure cookie encryption
# You can use: openssl rand -base64 32
NUXT_SESSION_PASSWORD=your-session-password-at-least-32-chars-long-here

# -----------------------------------------------------------------------------
# Site URL Configuration
# -----------------------------------------------------------------------------
# Local development: http://localhost:3000
# Kubernetes (Docker Desktop): http://localhost:30000
# Production: https://your-domain.com
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Socket.IO URL (only needed if different from main app)
# Local development: http://localhost:3001
# Kubernetes (Docker Desktop): http://localhost:30001
NUXT_PUBLIC_SOCKET_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# OAuth - Google (OPTIONAL - for Google login)
# -----------------------------------------------------------------------------
# Get these from Google Cloud Console:
# 1. Go to https://console.cloud.google.com/
# 2. Create a project → APIs & Services → Credentials → Create OAuth Client ID
# 3. Add authorized redirect URI: http://localhost:3000/api/auth/callback/google
NUXT_OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret

# -----------------------------------------------------------------------------
# OAuth - GitHub (OPTIONAL - for GitHub login)
# -----------------------------------------------------------------------------
# Get these from GitHub Developer Settings:
# 1. Go to https://github.com/settings/developers
# 2. Create New OAuth App
# 3. Set Authorization callback URL: http://localhost:3000/api/auth/callback/github
NUXT_OAUTH_GITHUB_CLIENT_ID=your-github-client-id
NUXT_OAUTH_GITHUB_CLIENT_SECRET=your-github-client-secret
