{
  "name": "cse590-04-final-project",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "concurrently \"npm run dev:nuxt\" \"npm run dev:socket\"",
    "dev:nuxt": "nuxt dev",
    "dev:socket": "node socket-server.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "patch-package && nuxt prepare",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "docker:build": "docker build -t gaming-platform:latest .",
    "k8s:deploy": "kubectl apply -k k8s/",
    "k8s:delete": "kubectl delete -k k8s/",
    "k8s:logs:app": "kubectl logs -f deployment/gaming-platform-app -n gaming-platform",
    "k8s:logs:socket": "kubectl logs -f deployment/gaming-platform-socket -n gaming-platform",
    "k8s:status": "kubectl get all -n gaming-platform",
    "k8s:port-forward": "kubectl port-forward svc/gaming-platform-app 3000:3000 -n gaming-platform & kubectl port-forward svc/gaming-platform-socket 3001:3001 -n gaming-platform"
  },
  "dependencies": {
    "@heroicons/vue": "2.2.0",
    "@nuxtjs/tailwindcss": "6.12.0",
    "@pinia/nuxt": "0.11.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "@vueuse/core": "14.0.0",
    "bcryptjs": "2.4.3",
    "jsonwebtoken": "9.0.2",
    "mongoose": "9.0.0",
    "nuxt": "3.20.1",
    "nuxt-auth-utils": "^0.5.25",
    "pinia-plugin-persistedstate": "4.7.1",
    "redis": "^5.10.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@tailwindcss/forms": "0.5.9",
    "@types/bcryptjs": "2.4.6",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.10.2",
    "autoprefixer": "10.4.20",
    "concurrently": "^9.2.1",
    "patch-package": "^8.0.1",
    "postcss": "8.4.49",
    "postcss-normalize-display-values": "^7.0.1",
    "tailwindcss": "3.4.16",
    "vitest": "2.1.8"
  }
}
